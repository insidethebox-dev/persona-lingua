// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id             String   @id @default(cuid())
  name           String
  address        String?
  phone          String?
  email          String?  @unique
  password       String? // For school admin login - nullable for migration
  profilePicture String? // Cloudinary URL for profile image
  publicId       String? // Cloudinary public ID for profile management
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  teachers          Teacher[]
  learningMaterials LearningMaterial[]

  @@map("schools")
}

model Teacher {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  password       String
  schoolId       String? // Made nullable to support independent teachers
  subject        String? // Teacher's subject/specialization
  bio            String? // Teacher's biography
  profilePicture String? // Cloudinary URL for profile image
  publicId       String? // Cloudinary public ID for profile management
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  school   School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  students Student[]

  @@map("teachers")
}

model Student {
  id              String   @id @default(cuid())
  name            String
  age             Int?
  grade           String?
  notes           String?
  learningBarriers String[] @default([]) // Learning barriers/accessibility needs
  teacherId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacher         Teacher          @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  reports         StudentReport[]
  recommendations Recommendation[]

  @@map("students")
}

model StudentReport {
  id        String   @id @default(cuid())
  title     String
  content   String
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_reports")
}

model LearningMaterial {
  id           String   @id @default(cuid())
  title        String
  description  String?
  aiSummary    String? // AI-generated summary of the material
  filename     String
  originalName String
  mimeType     String
  size         Int
  fileUrl      String? // URL for cloud storage (Cloudinary)
  publicId     String? // Cloudinary public ID for management
  topic        String // Subject topic
  level        String // Grade level
  type         String // Material type (question, multiple choice, summary)
  skill        String // Skill targeted (grammar, vocabulary, listening)
  tags         String[] @default([]) // Additional custom tags
  uploadedBy   String // Teacher ID who uploaded
  schoolId     String? // School this material belongs to (null for independent teachers)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  school          School?          @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  recommendations Recommendation[]

  @@map("learning_materials")
}

model Recommendation {
  id                 String   @id @default(cuid())
  studentId          String
  learningMaterialId String
  reason             String
  confidence         Float    @default(0.0)
  viewed             Boolean  @default(false)
  createdAt          DateTime @default(now())

  student          Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  learningMaterial LearningMaterial @relation(fields: [learningMaterialId], references: [id], onDelete: Cascade)

  @@unique([studentId, learningMaterialId])
  @@map("recommendations")
}
