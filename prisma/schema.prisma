generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                String             @id @default(cuid())
  name              String
  address           String?
  phone             String?
  email             String?            @unique
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  password          String?
  profilePicture    String?
  publicId          String?
  learningMaterials LearningMaterial[]
  teachers          Teacher[]

  @@map("schools")
}

model Teacher {
  id                String             @id @default(cuid())
  email             String             @unique
  name              String
  password          String
  schoolId          String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  bio               String?
  profilePicture    String?
  publicId          String?
  subject           String?
  learningMaterials LearningMaterial[]
  students          Student[]
  school            School?            @relation(fields: [schoolId], references: [id])

  @@map("teachers")
}

model Student {
  id               String                    @id @default(cuid())
  name             String
  age              Int?
  grade            String?
  notes            String?
  teacherId        String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  learningBarriers String[]                  @default([])
  language         String
  recommendations  Recommendation[]
  materialProgress StudentMaterialProgress[]
  reports          StudentReport[]
  teacher          Teacher                   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("students")
}

model StudentReport {
  id        String   @id @default(cuid())
  title     String
  content   String
  studentId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("student_reports")
}

model LearningMaterial {
  id               String                    @id @default(cuid())
  title            String
  description      String?
  filename         String
  originalName     String
  mimeType         String
  size             Int
  tags             String[]                  @default([])
  uploadedBy       String
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  aiSummary        String?
  fileUrl          String?
  level            String
  publicId         String?
  schoolId         String?
  skill            String
  topic            String?
  type             String
  language         String
  school           School?                   @relation(fields: [schoolId], references: [id])
  teacher          Teacher                   @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)
  recommendations  Recommendation[]
  materialProgress StudentMaterialProgress[]

  @@map("learning_materials")
}

model Recommendation {
  id                 String           @id @default(cuid())
  studentId          String
  learningMaterialId String
  reason             String
  confidence         Float            @default(0.0)
  viewed             Boolean          @default(false)
  createdAt          DateTime         @default(now())
  preScore           Float?
  scoreRationale     String?
  learningMaterial   LearningMaterial @relation(fields: [learningMaterialId], references: [id], onDelete: Cascade)
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, learningMaterialId])
  @@map("recommendations")
}

model TeacherAssistant {
  id               String   @id @default(cuid())
  assistantId      String   @unique
  teacherId        String
  threadId         String?  // Optional - for backward compatibility with old records
  studentId        String?  // Optional - for backward compatibility with old records
  sessionData      Json?    // Optional - for backward compatibility with old records
  conversationLogs Json[]   @default([]) // For backward compatibility with old records
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@index([assistantId])
  @@map("teacher_assistants")
}

model StudentThread {
  id               String   @id @default(cuid())
  threadId         String   @unique
  studentId        String
  teacherId        String
  assistantId      String
  sessionData      Json?
  conversationLogs Json[]   @default([])
  status           String   @default("active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([studentId])
  @@index([teacherId])
  @@index([threadId])
  @@map("student_threads")
}

model StudentMaterialProgress {
  id                 String           @id @default(cuid())
  studentId          String
  learningMaterialId String
  isCompleted        Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  learningMaterial   LearningMaterial @relation(fields: [learningMaterialId], references: [id], onDelete: Cascade)
  student            Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, learningMaterialId])
  @@index([studentId])
  @@index([learningMaterialId])
  @@map("student_material_progress")
}
